              <stringProp name="script">String state = new String(vars.get(&quot;state4&quot;));
state = state.replace(&quot;&amp;#x3d;&quot;,&quot;=&quot;);

log.info(state);
vars.put(&quot;decoded_state4&quot;, state);
</stringProp>
