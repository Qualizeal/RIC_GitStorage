            fieldIndex
            choice
            sectionIndex
            condition
            fieldType
            value
            __typename
          }
          showIfAny {
            pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            __typename
          }
          fieldGroups {
            field {
              _id
              fieldId
              label
              choices
              value
              placeholder
              answerType {
                _id
                answerType
                choicesAvailable
                __typename
              }
              __typename
            }
            display {
              flex
              __typename
            }
            value
            apiModelRef
            apiModelRefSecondary
            validation {
              required
              errorMessage
              minLength
              maxLength
              __typename
            }
            __typename
