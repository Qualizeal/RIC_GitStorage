        reasonForNotPaying
        otherReasonCommentForPatientResponsibility
        __typename
      }
      patientOutstanding {
        isOutstandingBalance
        amount
        comments
        isTotalOutstandingCollected
        collectedAmount
        commentsAtCollection
        isOutstandingPaidPartially
        reasonForNotPaying
        otherReasonCommentForOutstanding
        __typename
      }
      timeStamp
      billedBy
      collectedBy
      responsibilityDeniedReason
      responsibilityDeniedOtherReason
      isCOFCardDetailForEMREnabled
      eMRCardDetailReason
      eMRCardDetailOtherReason
      __typename
    }
    birdEyeAudit {
      checkinId
      customerId
      error
      __typename
    }
    mrn
    centerInfo {
      centerId
      facilityName
      providerName
      orgName
      address {
        address1
        city
        state
        zipcode
        coordinates
        __typename
      }
      __typename
    }
    email
    phoneNumber
    createdDateTime
    updatedDateTime
    appointment {
      date
      startTimeInMins
      endTimeInMins
      slotQueue
      reasonForReschedule
      isDynamicallyAdded
      __typename
    }
    reason
    anyOtherReason
    visitTypeOther
    visitTypePhysical
    dateOfInjury
    currentStatusCode
    currentSubStatusCode
    consentToSMSNotification
    isNewVisit
    isFollowUpVisit
    isFollowUpCreated
    followup {
      visitTimeStamp
      visitClinic
      visitCreatedBy
      visitCode
      __typename
    }
    attendedBy
    patientInfo {
      patientId
      firstName
      lastName
      middleName
      preferredName
      dateOfBirth
      sex
      language
      isMarried
      ethnicity
      race
      preferredPharmacy {
        name
        address
        __typename
      }
      __typename
