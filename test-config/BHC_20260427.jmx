                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;getSlots&quot;,&quot;variables&quot;:{&quot;centerId&quot;:&quot;6883&quot;,&quot;date&quot;:&quot;2026-04-27T00:00:00.000Z&quot;},&quot;query&quot;:&quot;query getSlots($centerId: String!, $date: DateTime!) {\n  getSlots(centerId: $centerId, date: $date) {\n    _id\n    centerId\n    date\n    slots {\n      startTimeInMins\n      endTimeInMins\n      totalSlots\n      requestedSlots\n      canceledSlots\n      availableSlots\n      isOpenToPatientApp\n      usedSlots\n      isSlotQueueSelectionEnabled\n      schema_version\n      offlineSlots\n      onlineSlots\n      usedOfflineSlots\n      usedOnlineSlots\n      isExtraHourOfClinic\n      blockedSlots {\n        slotQueue\n        createdTimeStamp\n        __typename\n      }\n      dynamicSlotAddition {\n        cancelled {\n          reason\n          action\n          totalSlots\n          offlineSlots\n          onlineSlots\n          visits {\n            _id\n            phoneNumber\n            visitAppointment {\n              date\n              startTimeInMins\n              endTimeInMins\n              slotQueue\n              slotStartTime\n              slotEndTime\n              reasonForReschedule\n              __typename\n            }\n            patientInfo {\n              patientId\n              firstName\n              lastName\n              middleName\n              fullName\n              preferredName\n              dateOfBirth\n              sex\n              language\n              isMarried\n              ethnicity\n              race\n              ssn\n              __typename\n            }\n            __typename\n          }\n          __typename\n        }\n        completed {\n          reason\n          action\n          totalSlots\n          offlineSlots\n          onlineSlots\n          visits {\n            _id\n            phoneNumber\n            visitAppointment {\n              date\n              startTimeInMins\n              endTimeInMins\n              slotQueue\n              slotStartTime\n              slotEndTime\n              reasonForReschedule\n              __typename\n            }\n            patientInfo {\n              patientId\n              firstName\n              lastName\n              middleName\n              fullName\n              preferredName\n              dateOfBirth\n              sex\n              language\n              isMarried\n              ethnicity\n              race\n              ssn\n              __typename\n            }\n            __typename\n          }\n          __typename\n        }\n        unused {\n          totalSlots\n          lastUpdated\n          __typename\n        }\n        dynamicAdditionBuffer\n        __typename\n      }\n      prioritizeWalkIn\n      bookAheadSlotPreference {\n        enabled\n        bookAheadTimeFrameInMinutes\n        __typename\n      }\n      addedDynamicSlots\n      usedDynamicSlots\n      __typename\n    }\n    slotAudit {\n      slotEditId\n      slotEditingStartedAt\n      isEditingCompleted\n      timeStamp\n      actionTakenBy\n      actionTakenByEmail\n      __typename\n    }\n    __typename\n  }\n}&quot;}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="GraphQLHTTPSampler.operationName">getSlots</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query getSlots($centerId: String!, $date: DateTime!) {
  getSlots(centerId: $centerId, date: $date) {
    _id
    centerId
    date
    slots {
      startTimeInMins
      endTimeInMins
      totalSlots
      requestedSlots
      canceledSlots
      availableSlots
      isOpenToPatientApp
      usedSlots
      isSlotQueueSelectionEnabled
      schema_version
      offlineSlots
      onlineSlots
      usedOfflineSlots
      usedOnlineSlots
      isExtraHourOfClinic
      blockedSlots {
        slotQueue
        createdTimeStamp
        __typename
      }
      dynamicSlotAddition {
        cancelled {
          reason
          action
          totalSlots
          offlineSlots
          onlineSlots
          visits {
            _id
            phoneNumber
            visitAppointment {
              date
              startTimeInMins
              endTimeInMins
              slotQueue
              slotStartTime
              slotEndTime
              reasonForReschedule
              __typename
            }
            patientInfo {
              patientId
              firstName
              lastName
              middleName
              fullName
              preferredName
              dateOfBirth
              sex
              language
              isMarried
              ethnicity
              race
              ssn
              __typename
            }
            __typename
          }
          __typename
        }
        completed {
          reason
          action
          totalSlots
          offlineSlots
          onlineSlots
          visits {
            _id
            phoneNumber
            visitAppointment {
              date
              startTimeInMins
              endTimeInMins
              slotQueue
              slotStartTime
              slotEndTime
              reasonForReschedule
              __typename
            }
            patientInfo {
              patientId
              firstName
              lastName
              middleName
              fullName
              preferredName
              dateOfBirth
              sex
              language
              isMarried
              ethnicity
              race
              ssn
              __typename
            }
            __typename
          }
          __typename
        }
        unused {
          totalSlots
          lastUpdated
          __typename
        }
        dynamicAdditionBuffer
        __typename
      }
      prioritizeWalkIn
      bookAheadSlotPreference {
        enabled
        bookAheadTimeFrameInMinutes
        __typename
      }
      addedDynamicSlots
      usedDynamicSlots
      __typename
    }
    slotAudit {
      slotEditId
      slotEditingStartedAt
      isEditingCompleted
      timeStamp
      actionTakenBy
      actionTakenByEmail
      __typename
    }
    __typename
  }
}
</stringProp>
