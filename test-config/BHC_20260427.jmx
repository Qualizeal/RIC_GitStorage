              label
              queue
              open
              selected
              isNow
              isAfterFiveMinutes
              isSlotAlreadyUsed
              __typename
            }
            __typename
          }
          __typename
        }
        __typename
      }
      miles
      __typename
    }
    nearestCenterSlotOutput {
      center {
