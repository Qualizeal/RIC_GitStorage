            fieldIndex
            choice
            sectionIndex
            __typename
          }
          __typename
        }
        questions {
          label
          labelHeader
          labelHtml
          hint
          help
          indicate
          showIf {
            pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            condition
            fieldType
            value
            __typename
          }
          showIfAny {
            pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            __typename
          }
          fieldGroups {
            field {
              _id
              fieldId
              label
              choices
