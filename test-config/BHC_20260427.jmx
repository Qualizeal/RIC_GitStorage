      isExtraHourOfClinic
      blockedSlots {
        slotQueue
        createdTimeStamp
        __typename
      }
      dynamicSlotAddition {
        cancelled {
          reason
          action
          totalSlots
          offlineSlots
          onlineSlots
          visits {
            _id
            phoneNumber
            visitAppointment {
              date
              startTimeInMins
              endTimeInMins
              slotQueue
              slotStartTime
              slotEndTime
              reasonForReschedule
              __typename
            }
            patientInfo {
              patientId
              firstName
              lastName
              middleName
              fullName
              preferredName
              dateOfBirth
              sex
              language
              isMarried
              ethnicity
              race
              ssn
              __typename
            }
            __typename
          }
          __typename
        }
        completed {
          reason
          action
          totalSlots
          offlineSlots
          onlineSlots
          visits {
            _id
            phoneNumber
            visitAppointment {
              date
              startTimeInMins
              endTimeInMins
