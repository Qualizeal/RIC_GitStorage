            startTimeInMins
            endTimeInMins
            date
            usedSlots
            isSlotQueueSelectionEnabled
            totalSlots
            offlineSlots
            onlineSlots
            usedOfflineSlots
            usedOnlineSlots
            availableSlots
            slotDuringHourList {
              slotStartTime
