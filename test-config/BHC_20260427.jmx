                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;getSlots&quot;,&quot;variables&quot;:{&quot;centerId&quot;:&quot;${P_id}&quot;,&quot;date&quot;:&quot;${__time(YYYY-MM-dd,)}T00:00:00.000Z&quot;},&quot;query&quot;:&quot;query getSlots($centerId: String!, $date: DateTime!) {\n  getSlots(centerId: $centerId, date: $date) {\n    _id\n    centerId\n    date\n    slots {\n      startTimeInMins\n      endTimeInMins\n      totalSlots\n      requestedSlots\n      canceledSlots\n      availableSlots\n      isOpenToPatientApp\n      usedSlots\n      isSlotQueueSelectionEnabled\n      schema_version\n      offlineSlots\n      onlineSlots\n      usedOfflineSlots\n      usedOnlineSlots\n      isExtraHourOfClinic\n      blockedSlots {\n        slotQueue\n        createdTimeStamp\n        __typename\n      }\n      dynamicSlotAddition {\n        cancelled {\n          reason\n          action\n          totalSlots\n          offlineSlots\n          onlineSlots\n          visits {\n            _id\n            phoneNumber\n            visitAppointment {\n              date\n              startTimeInMins\n              endTimeInMins\n              slotQueue\n              slotStartTime\n              slotEndTime\n              reasonForReschedule\n              __typename\n            }\n            patientInfo {\n              patientId\n              firstName\n              lastName\n              middleName\n              fullName\n              preferredName\n              dateOfBirth\n              sex\n              language\n              isMarried\n              ethnicity\n              race\n              ssn\n              __typename\n            }\n            __typename\n          }\n          __typename\n        }\n        completed {\n          reason\n          action\n          totalSlots\n          offlineSlots\n          onlineSlots\n          visits {\n            _id\n            phoneNumber\n            visitAppointment {\n   