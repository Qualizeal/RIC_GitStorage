k\n      __typename\n    }\n    locale {\n      countryId\n      countryName\n      regionId\n      regionName\n      orgId\n      orgName\n      orgDisplayName\n      divisionId\n      divisionName\n      orgAccronym\n      __typename\n    }\n    insuranceCompany\n    insuranceNotAcceptedForCompany\n    workSchedule {\n      openingTime\n      closingTime\n      slotDuration\n      workingDaysOfWeek\n      slots {\n        startTimeInMins\n        endTimeInMins\n        totalSlots\n        requestedSlots\n        canceledSlots\n        availableSlots\n        isOpenToPatientApp\n        isSlotQueueSelectionEnabled\n        offlineSlots\n        onlineSlots\n        dynamicSlotAddition {\n          dynamicAdditionBuffer\n          __typename\n        }\n        prioritizeWalkIn\n        bookAheadSlotPreference {\n          enabled\n          bookAheadTimeFrameInMinutes\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    slotConfiguration {\n      startTimeInMins\n      endTimeInMins\n      noOfSlots\n      isToday\n      __typename\n    }\n    facilityAccronym\n    timezone\n    centerStatus\n    temporarilyClosedDateTime\n    temporarilyStartDateTime\n    comingSoonDateTime\n    operationalStartDate\n    isAllergyTestingEnabled\n    allergyTestingConfig {\n      daysOfWeek\n      weeksInAdvance\n      openingTime\n      closingTime\n      __typename\n    }\n    __typename\n  }\n}&quot;}</stringProp>
