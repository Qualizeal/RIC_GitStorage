    isTransferEnabled
    isTransferEnabled
    address {
      state
      zipcode
      address1
      city
      coordinates
      clinicPhoneNumber
      clinicFaxNumber
      landmark
      __typename
    }
    locale {
      countryId
      countryName
      regionId
      regionName
      orgId
      orgName
      orgDisplayName
      divisionId
      divisionName
      orgAccronym
      __typename
    }
    insuranceCompany
    insuranceNotAcceptedForCompany
    workSchedule {
      openingTime
      closingTime
      slotDuration
      workingDaysOfWeek
      slots {
        startTimeInMins
        endTimeInMins
        totalSlots
        requestedSlots
        canceledSlots
        availableSlots
        isOpenToPatientApp
        isSlotQueueSelectionEnabled
        offlineSlots
        onlineSlots
        dynamicSlotAddition {
          dynamicAdditionBuffer
          __typename
        }
        prioritizeWalkIn
