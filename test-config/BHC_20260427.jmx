            <stringProp name="GraphQLHTTPSampler.query">query getCentersByOrgWithSlots($coordinates: [Float!], $orgId: String!, $date: DateTime!, $limit: Int, $skip: Int, $isNearest: Boolean!) {
  getCentersByOrgWithSlots(
    coordinates: $coordinates
    orgId: $orgId
    date: $date
    limit: $limit
    skip: $skip
    isNearest: $isNearest
  ) {
    totalCenterCount
    centerSlotOutput {
