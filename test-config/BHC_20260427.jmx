                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;getVisits&quot;,&quot;variables&quot;:{&quot;centerId&quot;:&quot;6883&quot;,&quot;date&quot;:&quot;2026-04-27T04:00:00.000Z&quot;,&quot;pageNumber&quot;:1,&quot;pageSize&quot;:200},&quot;query&quot;:&quot;query getVisits($centerId: String!, $date: DateTime!) {\n  getVisits(centerId: $centerId, date: $date) {\n    _id\n    checkinLocation\n    channel\n    visitCreatedIn\n    visitCreatedByPCPUser\n    pcpUserEmail\n    email\n    mrn\n    isPatientFoundInEpicRecord\n    symptoms\n    reasonForVisit\n    phoneNumber\n    createdDateTime\n    updatedDateTime\n    isEpic\n    isPhotoIdCopyAvailable\n    isInsuranceIdCopyAvailable\n    isFollowUpVisit\n    isFollowUpCreated\n    isEpicDFDPatientBalanceEnabled\n    visitCancellationPrediction {\n      dfdVisitId\n      cancellation_prob\n      process_time\n      __typename\n    }\n    campaigns {\n      campaignKey\n      campaignActions {\n        actionType\n        actionCompleted\n        __typename\n      }\n      __typename\n    }\n    isEpicReminderSent\n    occMedNewCompany\n    extraVirtualMessageSent\n    occMed {\n      employerServiceType\n      workCompType\n      authorizationLetterUri {\n        front {\n          name\n          uri\n          __typename\n        }\n        __typename\n      }\n      authorizationFromValid\n      companyName\n      companyPhone\n      companySupContactName\n      companySupContactEmail\n      companyAddress\n      relationshipToPatient\n      rescheduleLocationIfRequired\n      __typename\n    }\n    patientInfo {\n      patientId\n      firstName\n      lastName\n      dateOfBirth\n      __typename\n    }\n    contactDetails {\n      phoneNumber\n      email\n      __typename\n    }\n    insuranceInfo {\n      insuranceCompany\n      isInsurancePlanIsNotAccepted\n      insurancePlan\n      __typename\n    }\n    appointment {\n      date\n      startTimeInMins\n      endTimeInMins\n      slotQueue\n      isDynamicallyAdded\n      __typename\n    }\n    registrationChecks {\n      identity\n      forms\n      insurance\n      medicare\n      patientDetails\n      contactDetails\n      insuranceDetails\n      medicare\n      insuranceHolder\n      financialResponsibility\n      condOfServAndConsentToTreat\n      patientFinancialResponsibility\n      authToReleaseInfo\n      ackOfRightsAndPrivacy\n      medicalRecordDiscloser\n      childProxyForm\n      childProxyConsent\n      __typename\n    }\n    iAmHere\n    isVisitConfirmed\n    notes {\n      comments\n      timeStamp\n      notesBy\n      hasNew\n      email\n      __typename\n    }\n    centerInfo {\n      centerId\n      facilityName\n      providerName\n      orgName\n      __typename\n    }\n    reason\n    isNewVisit\n    preVisitId\n    anyOtherReason\n    visitTypePhysical\n    dateOfInjury\n    visitAudit {\n      timeStamp\n      actionTakenBy\n      field\n      fieldAudit {\n        fieldName\n        oldValue\n        newValue\n        __typename\n      }\n      __typename\n    }\n    delayTime {\n      delayedByInMinutes\n      actualDelayTime\n      inExamDelay\n      __typename\n    }\n    isNewPatientApp\n    priority\n    isWellStreetEmployee\n    idMismatchInfo\n    insuranceMismatchInfo\n    currentStatusCode\n    attendedBy\n    isAdhocVisit\n    isTytoVisit\n    tytoVisitRelation {\n      parentVisitId\n      parentCenterId\n      childVisitId\n      childCenterId\n      childCurrentStatusCode\n      conversionComment\n      unconversionComment\n      __typename\n    }\n    isNurseVisit\n    isTelemedVisit\n    isBehavioralHealthVisit\n    currentSubStatusCode\n    consentToSMSNotification\n    visitType\n    isOccMedVisit\n    employeeServiceType\n    inExamAttendedBy {\n      _id\n      attendedBy\n      userJoined\n      isUserEverJoined\n      isVideoLinkShared\n      isClaimed\n      providerJoined\n      isProviderEverJoined\n      isUserEncounteredError\n      userSessionAudit\n      isProviderEncounteredError\n      notes {\n        comments\n        timeStamp\n        notesBy\n        email\n        __typename\n      }\n      __typename\n    }\n    isFollowUpPhysicalVisit\n    isInClinicProviderVisitRequired\n    isFollowUpTelemedVisitCovidOnly\n    isFollowUpTelemedVisit\n    consent {\n      consentToTreat\n      consentToFinanicalResposibity\n      consentToReleaseInformation\n      consentToChildProxy\n      consentToPrivacy\n      consentToSelfPay\n      consentToTeleMedicine\n      convenientPay\n      __typename\n    }\n    rcmPayment {\n      patientResponsibility {\n        isAmountToBeCollected\n        isTypeCopay\n        isTypeCoInsurance\n        isTypeDeductible\n        isTypeSelfPay\n        paymentType {\n          coPay {\n            isAmountToBeCollected\n            amount\n            collected\n            isCollected\n            __typename\n          }\n          deductible {\n            isAmountToBeCollected\n            amount\n            collected\n            isCollected\n            __typename\n          }\n          selfPay {\n            isAmountToBeCollected\n            amount\n            collected\n            isCollected\n            __typename\n          }\n          __typename\n        }\n        amount\n        comments\n        isTotalAmountCollected\n        collectedAmount\n        commentsAtCollection\n        isResponsibilityPaidPartially\n        reasonForNotPaying\n        otherReasonCommentForPatientResponsibility\n        __typename\n      }\n      patientOutstanding {\n        isOutstandingBalance\n        amount\n        comments\n        isTotalOutstandingCollected\n        collectedAmount\n        commentsAtCollection\n        isOutstandingPaidPartially\n        reasonForNotPaying\n        otherReasonCommentForOutstanding\n        __typename\n      }\n      timeStamp\n      billedBy\n      collectedBy\n      responsibilityDeniedReason\n      responsibilityDeniedOtherReason\n      isCOFCardDetailForEMREnabled\n      eMRCardDetailReason\n      eMRCardDetailOtherReason\n      __typename\n    }\n    employerServiceType\n    workCompType\n    preScreeningQuestionnaire {\n      hasAsthmaOrWheezingHistory\n      hasHeartOrLungDiseaseHistory\n      hasEczemaHistory\n      isCurrentlyIll\n      isTakingBetaBlockerOrACEInhibitor\n      isTakingOralSteroids\n      isPregnant\n      __typename\n    }\n    __typename\n  }\n}&quot;}</stringProp>
