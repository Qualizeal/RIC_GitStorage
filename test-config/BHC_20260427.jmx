    _id
    centerId
    date
    slots {
      startTimeInMins
      endTimeInMins
      totalSlots
      requestedSlots
      canceledSlots
      availableSlots
      isOpenToPatientApp
      usedSlots
      isSlotQueueSelectionEnabled
      schema_version
      offlineSlots
      onlineSlots
      usedOfflineSlots
