    isFollowUpVisit
    isFollowUpCreated
    isEpicDFDPatientBalanceEnabled
    visitCancellationPrediction {
      dfdVisitId
      cancellation_prob
      process_time
      __typename
    }
    campaigns {
      campaignKey
      campaignActions {
        actionType
        actionCompleted
        __typename
      }
      __typename
    }
    isEpicReminderSent
    occMedNewCompany
    extraVirtualMessageSent
    occMed {
      employerServiceType
      workCompType
      authorizationLetterUri {
        front {
          name
          uri
          __typename
        }
        __typename
      }
      authorizationFromValid
      companyName
      companyPhone
      companySupContactName
      companySupContactEmail
      companyAddress
      relationshipToPatient
      rescheduleLocationIfRequired
      __typename
    }
    patientInfo {
      patientId
      firstName
      lastName
      dateOfBirth
      __typename
    }
    contactDetails {
      phoneNumber
      email
      __typename
    }
    insuranceInfo {
      insuranceCompany
      isInsurancePlanIsNotAccepted
      insurancePlan
      __typename
    }
    appointment {
      date
      startTimeInMins
      endTimeInMins
      slotQueue
      isDynamicallyAdded
      __typename
    }
    registrationChecks {
      identity
      forms
      insurance
      medicare
      patientDetails
      contactDetails
      insuranceDetails
      medicare
      insuranceHolder
      financialResponsibility
      condOfServAndConsentToTreat
      patientFinancialResponsibility
      authToReleaseInfo
      ackOfRightsAndPrivacy
      medicalRecordDiscloser
      childProxyForm
