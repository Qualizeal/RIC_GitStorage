            <stringProp name="GraphQLHTTPSampler.query">query getMetadataConfiguration($type: String!) {
  getMetadata(type: $type) {
    _id
    authConfiguration {
      roles {
        name
        privileges
        __typename
      }
      privileges
      __typename
    }
    workflowConfiguration {
      processes {
        name
        isActive
        description
        displayName
        code
        subProcesses {
          name
          isActive
          code
          description
          displayName
          actions {
            name
            description
            targetProcess
            targetSubProcess
            __typename
          }
          __typename
        }
        __typename
      }
      __typename
    }
    authorizationWorkflowConfiguration {
      processes {
        name
        isActive
        description
        displayName
        code
        subProcesses {
          name
          isActive
          code
          description
          displayName
          actions {
            name
            description
            targetProcess
            targetSubProcess
            __typename
          }
          __typename
        }
        __typename
      }
      __typename
    }
    preVisitWorkflowConfiguration {
      processes {
        name
        isActive
        description
        displayName
        code
        subProcesses {
          name
          isActive
          code
          description
          displayName
          actions {
            name
            description
            targetProcess
            targetSubProcess
            __typename
          }
          __typename
        }
        __typename
      }
      __typename
    }
    __typename
  }
}
