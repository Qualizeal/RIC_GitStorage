      countryName
      regionId
      regionName
      orgId
      orgName
      orgDisplayName
      divisionId
      divisionName
      orgAccronym
      __typename
    }
    insuranceCompany
    insuranceNotAcceptedForCompany
    workSchedule {
      openingTime
      closingTime
      slotDuration
      workingDaysOfWeek
      slots {
        startTimeInMins
        endTimeInMins
        totalSlots
        requestedSlots
        canceledSlots
        availableSlots
