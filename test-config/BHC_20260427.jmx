  medicalDisclosurePhoneNumber\n      phoneConsent\n      email\n      emailConsent\n      __typename\n    }\n    medicationHistory {\n      medication {\n        medicationName\n        dosage\n        frequency\n        __typename\n      }\n      noMedication\n      __typename\n    }\n    presentMedicalHistory {\n      acknowledgement\n      educationBoard\n      illnesses\n      injuries {\n        arms\n        back\n        head\n        legs\n        neck\n        operations\n        otherInjuries\n        __typename\n      }\n      occupationalHistory\n      __typename\n    }\n    iAmHere\n    currentStatusCode\n    physicalForms {\n      patientForm\n      childProxyForm\n      medicareForm\n      consentForm\n      selfPayForm\n      __typename\n    }\n    inExamAttendedBy {\n      _id\n      attendedBy\n      userJoined\n      isUserEverJoined\n      isVideoLinkShared\n      isClaimed\n      providerJoined\n      notes {\n        comments\n        timeStamp\n        notesBy\n        hasNew\n        email\n        __typename\n      }\n      __typename\n    }\n    previousNotes {\n      visitComments\n      visitTimeStamp\n      visitNotesBy\n      visitTelemedComments\n      visitTelemedNotesBy\n      visitTelemadTimeStamp\n      visitTelemedAttendedBy\n      visitCreatedBy\n      visitCode\n      isFollowUpTelemedVisit\n      isFollowUpTelemedVisitCovidOnly\n      isInClinicProviderVisitRequired\n      centerInfo {\n        centerId\n        facilityName\n        providerName\n        address {\n          address1\n          city\n          state\n          zipcode\n          coordinates\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    reasonForCancellation\n    reasonForCancellationComment\n    isFollowUpPhysicalVisit\n    isInClinicProviderVisitRequired\n    isFollowUpTelemedVisitCovidOnly\n    isFollowUpTelemedVisit\n    ethnicity\n    race\n    employerServiceType\n    __typename\n  }\n}&quot;}</stringProp>
