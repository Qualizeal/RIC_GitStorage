      phoneNumber
      email
      address1
      address2
      city
      state
      zipCode
      __typename
    }
    primaryCare {
      care
      physician
      phone
      __typename
    }
    emergencyContact {
      name
      firstName
      lastName
      phone
      relationship
      otherRelationship
      __typename
    }
    responsibleParty {
      relationshipToSubscriber
      firstName
      lastName
      dateOfBirth
      email
      phone
      __typename
    }
    priority
    isWellStreetEmployee
    isAdhocVisit
    isTytoVisit
    tytoVisitRelation {
      parentVisitId
      parentCenterId
      childVisitId
