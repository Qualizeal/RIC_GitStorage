      medicalRecordDiscloser
      childProxyForm
      childProxyConsent
      __typename
    }
    iAmHere
    isVisitConfirmed
    notes {
      comments
      timeStamp
      notesBy
      hasNew
      email
      __typename
    }
    centerInfo {
      centerId
      facilityName
      providerName
      orgName
      __typename
    }
    reason
    isNewVisit
    preVisitId
    anyOtherReason
    visitTypePhysical
    dateOfInjury
    visitAudit {
      timeStamp
      actionTakenBy
      field
      fieldAudit {
        fieldName
        oldValue
        newValue
        __typename
      }
      __typename
    }
    delayTime {
      delayedByInMinutes
      actualDelayTime
      inExamDelay
      __typename
    }
    isNewPatientApp
    priority
    isWellStreetEmployee
    idMismatchInfo
    insuranceMismatchInfo
    currentStatusCode
    attendedBy
    isAdhocVisit
    isTytoVisit
    tytoVisitRelation {
      parentVisitId
      parentCenterId
      childVisitId
      childCenterId
      childCurrentStatusCode
      conversionComment
      unconversionComment
      __typename
    }
    isNurseVisit
    isTelemedVisit
    isBehavioralHealthVisit
    currentSubStatusCode
    consentToSMSNotification
    visitType
    isOccMedVisit
    employeeServiceType
    inExamAttendedBy {
      _id
      attendedBy
      userJoined
      isUserEverJoined
      isVideoLinkShared
      isClaimed
      providerJoined
      isProviderEverJoined
      isUserEncounteredError
      userSessionAudit
      isProviderEncounteredError
      notes {
        comments
        timeStamp
        notesBy
        email
        __typename
      }
      __typename
    }
    isFollowUpPhysicalVisit
    isInClinicProviderVisitRequired
    isFollowUpTelemedVisitCovidOnly
    isFollowUpTelemedVisit
    consent {
      consentToTreat
      consentToFinanicalResposibity
      consentToReleaseInformation
      consentToChildProxy
      consentToPrivacy
      consentToSelfPay
      consentToTeleMedicine
      convenientPay
      __typename
