              preferredName
              dateOfBirth
              sex
              language
              isMarried
              ethnicity
              race
              ssn
              __typename
            }
            __typename
          }
          __typename
        }
        unused {
          totalSlots
          lastUpdated
          __typename
        }
        dynamicAdditionBuffer
        __typename
      }
      prioritizeWalkIn
      bookAheadSlotPreference {
        enabled
        bookAheadTimeFrameInMinutes
        __typename
      }
