            <stringProp name="HTTPSampler.port">443</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">utf-8</stringProp>
            <stringProp name="HTTPSampler.path">/graphql</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument" enabled="true">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;getVisitByIdAndDob&quot;,&quot;variables&quot;:{&quot;visitId&quot;:&quot;${decryptedvisitId}&quot;,&quot;dob&quot;:&quot;${P_dob}T00:00:00.000Z&quot;},&quot;query&quot;:&quot;query getVisitByIdAndDob($visitId: String!, $dob: DateTime!) {\n  getVisitByIdAndDob(visitId: $visitId, dob: $dob) {\n    _id\n    checkinLocation\n    channel\n    visitCreatedIn\n    visitCreatedByPCPUser\n    pcpUserEmail\n    isPatientFoundInEpicRecord\n    isEpicDFDPatientBalanceEnabled\n    isEpicReminderSent\n    occMedNewCompany\n    visitCancellationPrediction {\n      dfdVisitId\n      cancellation_prob\n      process_time\n      __typename\n    }\n    campaigns {\n      campaignKey\n      campaignActions {\n        actionType\n        actionCompleted\n        __typename\n      }\n      __typename\n    }\n    rcmPayment {\n      patientResponsibility {\n        isAmountToBeCollected\n        isTypeCopay\n        isTypeCoInsurance\n        isTypeDeductible\n        isTypeSelfPay\n        paymentType {\n          coPay {\n            isAmountToBeCollected\n            amount\n            collected\n            isCollected\n            __typename\n          }\n          deductible {\n            isAmountToBeCollected\n            amount\n            collected\n            isCollected\n            __typename\n          }\n          selfPay {\n            isAmountToBeCollected\n            amount\n            collected\n            isCollected\n            __typename\n          }\n          __typename\n        }\n        amount\n        comments\n        isTotalAmountCollected\n        collectedAmount\n        commentsAtCollection\n        isResponsibilityPaidPartially\n        reasonForNotPaying\n        otherReasonCommentForPatientResponsibility\n        __typename\n      }\n      patientOutstanding {\n        isOutstandingBalance\n        amount\n        comments\n        isTotalOutstandingCollected\n        collectedAmount\n        commentsAtCollection\n        isOutstandingPaidPartially\n        reasonForNotPaying\n        otherReasonCommentForOutstanding\n        __typename\n      }\n      timeStamp\n      billedBy\n      collectedBy\n      responsibilityDeniedReason\n      responsibilityDeniedOtherReason\n      isCOFCardDetailForEMREnabled\n      eMRCardDetailReason\n      eMRCardDetailOtherReason\n      __typename\n    }\n    birdEyeAudit {\n      checkinId\n      customerId\n      error\n      __typename\n    }\n    mrn\n    centerInfo {\n      centerId\n      facilityName\n      providerName\n      orgName\n      address {\n        address1\n        city\n        state\n        zipcode\n        coordinates\n        __typename\n      }\n      __typename\n    }\n    email\n    phoneNumber\n    createdDateTime\n    updatedDateTime\n    appointment {\n      date\n      startTimeInMins\n      endTimeInMins\n      slotQueue\n      reasonForReschedule\n      isDynamicallyAdded\n      __typename\n    }\n    reason\n    anyOtherReason\n    visitTypeOther\n    visitTypePhysical\n    dateOfInjury\n    currentStatusCode\n    currentSubStatusCode\n    consentToSMSNotification\n    isNewVisit\n    isFollowUpVisit\n    isFollowUpCreated\n    followup {\n      visitTimeStamp\n      visitClinic\n      visitCreatedBy\n      visitCode\n      __typename\n    }\n    attendedBy\n    patientInfo {\n      patientId\n      firstName\n      lastName\n      middleName\n      preferredName\n      dateOfBirth\n      sex\n      language\n      isMarried\n      ethnicity\n      race\n      preferredPharmacy {\n        name\n        address\n        __typename\n      }\n      __typename\n    }\n    photoIdUri {\n      front {\n        name\n        uri\n        previewBase64\n        __typename\n      }\n      back {\n        name\n        uri\n        previewBase64\n        __typename\n      }\n      __typename\n    }\n    contactDetails {\n      phoneNumber\n      email\n      address1