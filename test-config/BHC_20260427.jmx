                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;getMetadataConfiguration&quot;,&quot;variables&quot;:{&quot;type&quot;:&quot;telemedicine&quot;},&quot;query&quot;:&quot;query getMetadataConfiguration($type: String!) {\n  getMetadata(type: $type) {\n    _id\n    authConfiguration {\n      roles {\n        name\n        privileges\n        __typename\n      }\n      privileges\n      __typename\n    }\n    workflowConfiguration {\n      processes {\n        name\n        isActive\n        description\n        displayName\n        code\n        subProcesses {\n          name\n          isActive\n          code\n          description\n          displayName\n          actions {\n            name\n            description\n            targetProcess\n            targetSubProcess\n            __typename\n          }\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    authorizationWorkflowConfiguration {\n      processes {\n        name\n        isActive\n        description\n        displayName\n        code\n        subProcesses {\n          name\n          isActive\n          code\n          description\n          displayName\n          actions {\n            name\n            description\n            targetProcess\n            targetSubProcess\n            __typename\n          }\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    preVisitWorkflowConfiguration {\n      processes {\n        name\n        isActive\n        description\n        displayName\n        code\n        subProcesses {\n          name\n          isActive\n          code\n          description\n          displayName\n          actions {\n            name\n            description\n            targetProcess\n            targetSubProcess\n            __typename\n          }\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n}&quot;}