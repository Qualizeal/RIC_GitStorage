            <stringProp name="GraphQLHTTPSampler.operationName">getVisitByIdAndDob</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query getVisitByIdAndDob($visitId: String!, $dob: DateTime!) {
  getVisitByIdAndDob(visitId: $visitId, dob: $dob) {
    _id
    checkinLocation
    channel
    visitCreatedIn
    visitCreatedByPCPUser
    pcpUserEmail
    isPatientFoundInEpicRecord
    isEpicDFDPatientBalanceEnabled
