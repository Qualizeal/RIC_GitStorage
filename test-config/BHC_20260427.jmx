            isCollected
            __typename
          }
          deductible {
            isAmountToBeCollected
            amount
            collected
            isCollected
            __typename
          }
          selfPay {
            isAmountToBeCollected
            amount
            collected
            isCollected
            __typename
          }
          __typename
        }
        amount
        comments
        isTotalAmountCollected
        collectedAmount
        commentsAtCollection
