            <stringProp name="GraphQLHTTPSampler.variables">{&quot;variables&quot;:&quot;{\&quot;visitId\&quot;:\&quot;${C_visitId}\&quot;,\&quot;statusCode\&quot;:\&quot;EPICSCHEDULING\&quot;,\&quot;subStatusCode\&quot;:\&quot;STARTSCHEDULING\&quot;,\&quot;actionTakenBy\&quot;:\&quot;${P_actionTakenBy}\&quot;,\&quot;timeStamp\&quot;:\&quot;${__time(YYYY-MM-dd&apos;T&apos;HH:mm:ss:SSS&apos;Z&apos;,)}\&quot;}&quot;,&quot;operationName&quot;:&quot;updateVisitWorkFlowAuthorization&quot;,&quot;query&quot;:&quot;mutation updateVisitWorkFlowAuthorization($visitId: String!, $statusCode: String!, $subStatusCode: String!, $actionTakenBy: String, $timeStamp: DateTime!) {\n  updateVisitWorkFlowAuthorization(\n    visitId: $visitId\n    statusCode: $statusCode\n    subStatusCode: $subStatusCode\n    actionTakenBy: $actionTakenBy\n    timeStamp: $timeStamp\n  ) {\n    result\n    error\n    updatedAuthorization {\n      _id\n      employee {\n        _id\n        firstName\n        lastName\n        middleName\n      }\n      serviceId\n      serviceName\n      activities {\n        activityId\n        sequenceNo\n        name\n        codeVal\n      }\n      addDateTimeStamp\n      updatedDateTimeStamp\n      currentStatusCode\n      currentSubStatusCode\n      dfdVisitCode\n      agilityVisitTrx\n      workflow {\n        timeStamp\n        actionTakenBy\n        workflowStatusCode\n        auditEmail\n      }\n      visitWorkflow {\n        timeStamp\n        actionTakenBy\n        workflowStatusCode\n        workflowSubStatusCode\n      }\n      visCode {\n        categoryId\n        codeVal\n        codeName\n      }\n      employer {\n        employerId\n        name\n      }\n      clinic {\n        clinicId\n        name\n        address1\n        city\n        state\n        zip\n      }\n      reasonForCancellation\n      cancelledBy\n    }\n  }\n}\n&quot;}</stringProp>
