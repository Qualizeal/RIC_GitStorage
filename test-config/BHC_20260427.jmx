        supportsEmployerPortal
        supportsBilling
        __typename
      }
      preVisit {
        isPreVisitEnabled
        isPreVisitEnabledForLast2hour
        isPreVisitEnabledForWalkinOnly
        __typename
      }
      checkInForm {
        hideTimeSlots
        disableTimeSlots
        defaultNextAvailableSlot
        hideTimeSlotInfoInPA
        hideTomorrowSlotInEA
        __typename
      }
      selDepId
      employerServiceTypes
      slotBuffer {
        isEnabled
        bufferTimeInMinutes
        __typename
      }
      retainHoverStateOfCalendar
      isEnableInsuranceNavTab
      isEnableVisitCancellationFlow
      isHideAllTabQueueSection
      isEnableDueBalanceSearch
      isExtraVirtualMessageEnabled
      isExtraVirtualMessageAutoSentEnabled
      dynamicSlotReopening {
        completed {
          isEnabled
          isWalkInOnly
          timeframeInMins
          reason
          __typename
        }
        cancelled {
          isEnabled
          isWalkInOnly
          timeframeInMins
          dynamicQueueing {
            isEnabled
            firstIntervalInMinutes
            __typename
          }
          reason
          __typename
        }
        unusedSlots {
          isEnabled
          providersCount
          slotsPerProvider
          isWalkInOnly
          useBaseCapacityForCalculation
          __typename
        }
        rescheduling {
          isEnabled
          __typename
        }
        __typename
      }
      showDXPAssist
      slotPreferenceEnabled
      isInsurancePlanValidationEnabled
      isBehavioralHealthClinic
      tytoProps {
        isEnabled
        isSlotConsumable
        mappedCenter {
          id
          isSlotConsumable
          __typename
        }
        __typename
      }
      __typename
    }
    telemedicineCenterId
    isOcrEnabled
    isTransferEnabled
    isTransferEnabled
    address {
      state
      zipcode
      address1
      city
      coordinates
      clinicPhoneNumber
      clinicFaxNumber
      landmark
      __typename
    }
    locale {
      countryId
      countryName
      regionId
      regionName
      orgId
      orgName
      orgDisplayName
      divisionId
      divisionName
      orgAccronym
      __typename
    }
    insuranceCompany
    insuranceNotAcceptedForCompany
    workSchedule {
      openingTime
      closingTime
      slotDuration
      workingDaysOfWeek
      slots {
        startTimeInMins
        endTimeInMins
        totalSlots
        requestedSlots
        canceledSlots
        availableSlots
        isOpenToPatientApp
        isSlotQueueSelectionEnabled
        offlineSlots
        onlineSlots
        dynamicSlotAddition {
          dynamicAdditionBuffer
          __typename
        }
        prioritizeWalkIn
        bookAheadSlotPreference {
          enabled
          bookAheadTimeFrameInMinutes
          __typename
        }
        __typename
      }
      __typename
    }
    slotConfiguration {
      startTimeInMins
      endTimeInMins
      noOfSlots
      isToday
      __typename
    }
    facilityAccronym
    timezone
    centerStatus
    temporarilyClosedDateTime
    temporarilyStartDateTime
    comingSoonDateTime
    operationalStartDate
    isAllergyTestingEnabled
    allergyTestingConfig {
      daysOfWeek
      weeksInAdvance
      openingTime
      closingTime
      __typename
    }
    __typename
  }
}
