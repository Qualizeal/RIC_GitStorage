          offlineSlots
          onlineSlots
          visits {
            _id
            phoneNumber
            visitAppointment {
              date
              startTimeInMins
              endTimeInMins
              slotQueue
              slotStartTime
              slotEndTime
              reasonForReschedule
              __typename
            }
            patientInfo {
              patientId
