            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="false">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import java.util.Base64

def response = prev.getResponseDataAsString()

if (!response || !response.contains(&quot;base64EncodedString&quot;)) {
    log.error(&quot;No base64 PDF found in response&quot;)
    return
}

// Parse JSON
def json = new JsonSlurper().parseText(response)
def base64Str = json.data.exportRegistration.base64EncodedString

// Decode PDF
byte[] pdfBytes = Base64.decoder.decode(base64Str)

// ✅ USE YOUR EXISTING VARIABLE
def visitId = vars.get(&quot;C_visitId&quot;)
if (!visitId) {
    log.error(&quot;C_visitId is NULL at T18&quot;)
    return
}

// ✅ SAVE IN JMETER /bin
def file = new File(&quot;Registration_${visitId}.pdf&quot;)
file.bytes = pdfBytes

log.info(&quot;PDF saved successfully: &quot; + file.getAbsolutePath())</stringProp>
            </JSR223PostProcessor>
