isitEnabledForLast2hour\n        isPreVisitEnabledForWalkinOnly\n        __typename\n      }\n      checkInForm {\n        hideTimeSlots\n        disableTimeSlots\n        defaultNextAvailableSlot\n        hideTimeSlotInfoInPA\n        hideTomorrowSlotInEA\n        __typename\n      }\n      selDepId\n      employerServiceTypes\n      slotBuffer {\n        isEnabled\n        bufferTimeInMinutes\n        __typename\n      }\n      retainHoverStateOfCalendar\n      isEnableInsuranceNavTab\n      isEnableVisitCancellationFlow\n      isHideAllTabQueueSection\n      isEnableDueBalanceSearch\n      isExtraVirtualMessageEnabled\n      isExtraVirtualMessageAutoSentEnabled\n      dynamicSlotReopening {\n        completed {\n          isEnabled\n          isWalkInOnly\n          timeframeInMins\n          reason\n          __typename\n        }\n        cancelled {\n          isEnabled\n          isWalkInOnly\n          timeframeInMins\n          dynamicQueueing {\n            isEnabled\n            firstIntervalInMinutes\n            __typename\n          }\n          reason\n          __typename\n        }\n        unusedSlots {\n          isEnabled\n          providersCount\n          slotsPerProvider\n          isWalkInOnly\n          useBaseCapacityForCalculation\n          __typename\n        }\n        rescheduling {\n          isEnabled\n          __typename\n        }\n        __typename\n      }\n      showDXPAssist\n      slotPreferenceEnabled\n      isInsurancePlanValidationEnabled\n      isBehavioralHealthClinic\n      tytoProps {\n        isEnabled\n        isSlotConsumable\n        mappedCenter {\n          id\n          isSlotConsumable\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    telemedicineCenterId\n    isOcrEnabled\n    isTransferEnabled\n    isTransferEnabled\n    address {\n      state\n      zipcode\n      address1\n      city\n      coordinates\n      clinicPhoneNumber\n      clinicFaxNumber\n      landmar