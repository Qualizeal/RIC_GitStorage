            <stringProp name="GraphQLHTTPSampler.query">query getRegistrationTemplate($formTemplateName: String!, $lang: String!, $centerId: String!, $isNewFormTemplate: Boolean) {
  formTemplate(
    formTemplateName: $formTemplateName
    lang: $lang
    centerId: $centerId
    isNewFormTemplate: $isNewFormTemplate
  ) {
    _id
    formTemplateName
    version
    pages {
