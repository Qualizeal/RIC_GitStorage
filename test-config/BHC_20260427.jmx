            <stringProp name="HTTPSampler.domain">${domins}</stringProp>
            <stringProp name="HTTPSampler.port">443</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">utf-8</stringProp>
            <stringProp name="HTTPSampler.path">/graphql</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument" enabled="true">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;center&quot;,&quot;variables&quot;:{&quot;id&quot;:&quot;${P_id}&quot;},&quot;query&quot;:&quot;query center($id: String!) {\n  getCenter(_id: $id) {\n    _id\n    driveThroughAvailable\n    driveThroughClinicId\n    isDriveThroughCenter\n    facilityName\n    facilityType\n    wellstreetId\n    centerAudit {\n      user\n      userEmail\n      date\n      editId\n      editingStartedAt\n      isEditingCompleted\n      olderData\n      updatedData\n      field\n      __typename\n    }\n    twilioNumber\n    isWaitTimeEnabled\n    ezPayNotAcceptedInsurance\n    slotCutOffTimeInMins\n    configurableProperties {\n      isEpicWorkGroupEnabled\n      isEPICFeatureEnabled\n      isSMSAndReportsAreDisabled\n      bookAheadSlotConfiguration {\n        todaySlotCutoffTime\n        showTomorrowSlots\n        bookAheadCutoffEnabled\n        ignoreTimeForBookAheadCutoff\n        __typename\n      }\n      isRCMBillingEnabledThroughQueue\n      isProfileViewEnabled\n      isRCMBillingEnabledThroughProfile\n      isNewRCMBillingEnabled\n      isEmailCheckEnabled\n      isDelayTimeNotificationEnabled\n      delayTimeNotificationFrequencyInMinutes\n      autoCancellationWaitTimeInMinutes\n      reasonForVisit\n      occMedVisitTypes\n      checkInFormOptions\n      birdEyeId\n      isAutoCancellationEnabledForTelemed\n      waitTimeForSmsBeforeCancellation\n      isAgilityCheckEnabled\n      showAddressIn2Lines\n      isAddressCapitalized\n      addressFirstLineApt\n      showCancellationPrediction\n      isAutoTimerSMSNotificationEnabled\n      notification {\n        name\n        code\n        emailSubscribed\n        smsSubscribed\n        __typename\n      }\n      isNewUISupported\n      isLaunched\n      isCardOnFileEnabled\n      authorization {\n        supportsEmployerPortal\n        supportsBilling\n        __typename\n      }\n      preVisit {\n        isPreVisitEnabled\n        isPreVisitEnabledForLast2hour\n        isPreVisitEnabledForWalkinOnly\n        __typename\n      }\n      checkInForm {\n        hideTimeSlots\n        disableTimeSlots\n        defaultNextAvailableSlot\n        hideTimeSlotInfoInPA\n        hideTomorrowSlotInEA\n        __typename\n      }\n      selDepId\n      employerServiceTypes\n      slotBuffer {\n        isEnabled\n        bufferTimeInMinutes\n        __typename\n      }\n      retainHoverStateOfCalendar\n      isEnableInsuranceNavTab\n      isEnableVisitCancellationFlow\n      isHideAllTabQueueSection\n      isEnableDueBalanceSearch\n      isExtraVirtualMessageEnabled\n      isExtraVirtualMessageAutoSentEnabled\n      dynamicSlotReopening {\n        completed {\n          isEnabled\n          isWalkInOnly\n          timeframeInMins\n          reason\n          __typename\n        }\n        cancelled {\n          isEnabled\n          isWalkInOnly\n          timeframeInMins\n          dynamicQueueing {\n            isEnabled\n            firstIntervalInMinutes\n            __typename\n          }\n          reason\n          __typename\n        }\n        unusedSlots {\n          isEnabled\n          providersCount\n          slotsPerProvider\n          isWalkInOnly\n          useBaseCapacityForCalculation\n          __typename\n        }\n        rescheduling {\n          isEnabled\n          __typename\n        }\n        __typename\n      }\n      showDXPAssist\n      slotPreferenceEnabled\n      isInsurancePlanValidationEnabled\n      isBehavioralHealthClinic\n      tytoProps {\n        isEnabled\n        isSlotConsumable\n        mappedCenter {\n          id\n          isSlotConsumable\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    telemedicineCenterId\n    isOcrEnabled\n    isTransferEnabled\n    isTransferEnabled\n    address {\n      state\n      zipcode\n      address1\n      city\n      coordinates\n      clinicPhoneNumber\n      clinicFaxNumber\n      landmark\n      __typename\n    }\n    locale {\n      countryId\n      countryName\n      regionId\n      regionName\n      orgId\n      orgName\n      orgDisplayName\n      divisionId\n      divisionName\n      orgAccronym\n      __typename\n    }\n    insuranceCompany\n    insuranceNotAcceptedForCompany\n    workSchedule {\n      openingTime\n      closingTime\n      slotDuration\n      workingDaysOfWeek\n      slots {\n        startTimeInMins\n        endTimeInMins\n        totalSlots\n        requestedSlots\n        canceledSlots\n        availableSlots\n        isOpenToPatientApp\n        isSlotQueueSelectionEnabled\n        offlineSlots\n        onlineSlots\n        dynamicSlotAddition {\n          dynamicAdditionBuffer\n          __typename\n        }\n        prioritizeWalkIn\n        bookAheadSlotPreference {\n          enabled\n          bookAheadTimeFrameInMinutes\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    slotConfiguration {\n      startTimeInMins\n      endTimeInMins\n      noOfSlots\n      isToday\n      __typename\n    }\n    facilityAccronym\n    timezone\n    centerStatus\n    temporarilyClosedDateTime\n    temporarilyStartDateTime\n    comingSoonDateTime\n    operationalStartDate\n    isAllergyTestingEnabled\n    allergyTestingConfig {\n      daysOfWeek\n      weeksInAdvance\n      openingTime\n      closingTime\n      __typename\n    }\n    __typename\n  }\n}&quot;}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="GraphQLHTTPSampler.operationName">center</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query center($id: String!) {
  getCenter(_id: $id) {
    _id
    driveThroughAvailable
    driveThroughClinicId
    isDriveThroughCenter
    facilityName
    facilityType
    wellstreetId
    centerAudit {
      user
      userEmail
      date
      editId
      editingStartedAt
      isEditingCompleted
      olderData
      updatedData
      field
      __typename
    }
    twilioNumber
    isWaitTimeEnabled
    ezPayNotAcceptedInsurance
    slotCutOffTimeInMins
    configurableProperties {
      isEpicWorkGroupEnabled
      isEPICFeatureEnabled
      isSMSAndReportsAreDisabled
      bookAheadSlotConfiguration {
        todaySlotCutoffTime
        showTomorrowSlots
        bookAheadCutoffEnabled
        ignoreTimeForBookAheadCutoff
        __typename
      }
      isRCMBillingEnabledThroughQueue
      isProfileViewEnabled
      isRCMBillingEnabledThroughProfile
      isNewRCMBillingEnabled
      isEmailCheckEnabled
      isDelayTimeNotificationEnabled
      delayTimeNotificationFrequencyInMinutes
      autoCancellationWaitTimeInMinutes
      reasonForVisit
      occMedVisitTypes
      checkInFormOptions
      birdEyeId
      isAutoCancellationEnabledForTelemed
      waitTimeForSmsBeforeCancellation
      isAgilityCheckEnabled
      showAddressIn2Lines
      isAddressCapitalized
      addressFirstLineApt
      showCancellationPrediction
      isAutoTimerSMSNotificationEnabled
      notification {
        name
        code
        emailSubscribed
        smsSubscribed
        __typename
      }
      isNewUISupported
      isLaunched
      isCardOnFileEnabled
      authorization {
        supportsEmployerPortal
        supportsBilling
        __typename
      }
      preVisit {
        isPreVisitEnabled
        isPreVisitEnabledForLast2hour
        isPreVisitEnabledForWalkinOnly
        __typename
      }
      checkInForm {
        hideTimeSlots
        disableTimeSlots
        defaultNextAvailableSlot
        hideTimeSlotInfoInPA
        hideTomorrowSlotInEA
        __typename
      }
      selDepId
      employerServiceTypes
      slotBuffer {
        isEnabled
        bufferTimeInMinutes
        __typename
      }
      retainHoverStateOfCalendar
      isEnableInsuranceNavTab
      isEnableVisitCancellationFlow
      isHideAllTabQueueSection
      isEnableDueBalanceSearch
      isExtraVirtualMessageEnabled
      isExtraVirtualMessageAutoSentEnabled
      dynamicSlotReopening {
        completed {
          isEnabled
          isWalkInOnly
          timeframeInMins
          reason
          __typename
        }
        cancelled {
          isEnabled
          isWalkInOnly
          timeframeInMins
          dynamicQueueing {
            isEnabled
            firstIntervalInMinutes
            __typename
          }
          reason
          __typename
        }
        unusedSlots {
          isEnabled
          providersCount
          slotsPerProvider
          isWalkInOnly
          useBaseCapacityForCalculation
          __typename
        }
        rescheduling {
          isEnabled
          __typename
        }
        __typename
      }
      showDXPAssist
      slotPreferenceEnabled
      isInsurancePlanValidationEnabled
      isBehavioralHealthClinic
      tytoProps {
        isEnabled
        isSlotConsumable
        mappedCenter {
          id
          isSlotConsumable
          __typename
        }
        __typename
      }
      __typename
    }
    telemedicineCenterId
    isOcrEnabled
    isTransferEnabled
    isTransferEnabled
    address {
      state
      zipcode
      address1
      city
      coordinates
      clinicPhoneNumber
      clinicFaxNumber
      landmark
      __typename
    }
    locale {
      countryId
      countryName
      regionId
      regionName
      orgId
      orgName
      orgDisplayName
      divisionId
      divisionName
      orgAccronym
      __typename
    }
    insuranceCompany
    insuranceNotAcceptedForCompany
    workSchedule {
      openingTime
      closingTime
      slotDuration
      workingDaysOfWeek
      slots {
        startTimeInMins
        endTimeInMins
        totalSlots
        requestedSlots
        canceledSlots
        availableSlots
        isOpenToPatientApp
        isSlotQueueSelectionEnabled
        offlineSlots
        onlineSlots
        dynamicSlotAddition {
          dynamicAdditionBuffer
          __typename
        }
        prioritizeWalkIn
        bookAheadSlotPreference {
          enabled
          bookAheadTimeFrameInMinutes
          __typename
        }
        __typename
      }
      __typename
    }
    slotConfiguration {
      startTimeInMins
      endTimeInMins
      noOfSlots
      isToday
      __typename
    }
    facilityAccronym
    timezone
    centerStatus
    temporarilyClosedDateTime
    temporarilyStartDateTime
    comingSoonDateTime
    operationalStartDate
    isAllergyTestingEnabled
    allergyTestingConfig {
      daysOfWeek
      weeksInAdvance
      openingTime
      closingTime
      __typename
    }
    __typename
  }
}
</stringProp>
