  getChat(visitId: $visitId) {
    _id
    centerId
    isActive
    recepientPhoneNumber
    conversations {
      messageReferenceId
      from
      to
      type
      message
      createdDateTime
      __typename
    }
    createdDateTime
    updatedDateTime
    __typename
  }
}
</stringProp>
