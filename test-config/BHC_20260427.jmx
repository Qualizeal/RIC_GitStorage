            <stringProp name="HTTPSampler.domain">${domins}</stringProp>
            <stringProp name="HTTPSampler.port">443</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">utf-8</stringProp>
            <stringProp name="HTTPSampler.path">/graphql</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument" enabled="true">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;getSlots&quot;,&quot;variables&quot;:{&quot;centerId&quot;:&quot;${P_id}&quot;,&quot;date&quot;:&quot;${__time(YYYY-MM-dd,)}T00:00:00.000Z&quot;},&quot;query&quot;:&quot;query getSlots($centerId: String!, $date: DateTime!) {\n  getSlots(centerId: $centerId, date: $date) {\n    _id\n    centerId\n    date\n    slots {\n      startTimeInMins\n      endTimeInMins\n      totalSlots\n      requestedSlots\n      canceledSlots\n      availableSlots\n      isOpenToPatientApp\n      usedSlots\n      isSlotQueueSelectionEnabled\n      schema_version\n      offlineSlots\n      onlineSlots\n      usedOfflineSlots\n      usedOnlineSlots\n      isExtraHourOfClinic\n      blockedSlots {\n        slotQueue\n        createdTimeStamp\n        __typename\n      }\n      dynamicSlotAddition {\n        cancelled {\n          reason\n          action\n          totalSlots\n          offlineSlots\n          onlineSlots\n          visits {\n            _id\n            phoneNumber\n            visitAppointment {\n              date\n              startTimeInMins\n              endTimeInMins\n              slotQueue\n              slotStartTime\n              slotEndTime\n              reasonForReschedule\n              __typename\n            }\n            patientInfo {\n              patientId\n              firstName\n              lastName\n              middleName\n              fullName\n              preferredName\n              dateOfBirth\n              sex\n              language\n              isMarried\n              ethnicity\n              race\n              ssn\n              __typename\n            }\n            __typename\n          }\n          __typename\n        }\n        completed {\n          reason\n          action\n          totalSlots\n          offlineSlots\n          onlineSlots\n          visits {\n            _id\n            phoneNumber\n            visitAppointment {\n              date\n              startTimeInMins\n              endTimeInMins\n              slotQueue\n              slotStartTime\n              slotEndTime\n              reasonForReschedule\n              __typename\n            }\n            patientInfo {\n              patientId\n              firstName\n              lastName\n              middleName\n              fullName\n              preferredName\n              dateOfBirth\n              sex\n              language\n              isMarried\n              ethnicity\n              race\n              ssn\n              __typename\n            }\n            __typename\n          }\n          __typename\n        }\n        unused {\n          totalSlots\n          lastUpdated\n          __typename\n        }\n        dynamicAdditionBuffer\n        __typename\n      }\n      prioritizeWalkIn\n      bookAheadSlotPreference {\n        enabled\n        bookAheadTimeFrameInMinutes\n        __typename\n      }\n      addedDynamicSlots\n      usedDynamicSlots\n      __typename\n    }\n    slotAudit {\n      slotEditId\n      slotEditingStartedAt\n      isEditingCompleted\n      timeStamp\n      actionTakenBy\n      actionTakenByEmail\n      __typename\n    }\n    __typename\n  }\n}&quot;}</stringProp>
