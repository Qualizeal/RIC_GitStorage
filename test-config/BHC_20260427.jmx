    rcmPayment {
      patientResponsibility {
        isAmountToBeCollected
        isTypeCopay
        isTypeCoInsurance
        isTypeDeductible
        isTypeSelfPay
        paymentType {
          coPay {
            isAmountToBeCollected
            amount
            collected
            isCollected
            __typename
          }
          deductible {
            isAmountToBeCollected
            amount
            collected
            isCollected
            __typename
