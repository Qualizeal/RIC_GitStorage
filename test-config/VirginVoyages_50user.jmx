            <stringProp name="GraphQLHTTPSampler.query">
  query ($value: AddonAvailabilityRequest) {
    addOnAvailability(value: $value) {
      cabinSeqNo
      addOns {
        shortDescription
        addonType
        name
        longName
        landscapeTitleImage {
          alt
          src
        }
        code
        detailReceiptDescription
        longDescription
        thumbnailImage {
          alt
          src
        }
        wideFlyoutImage {
          alt
          src
        }
        subtitle
        needToKnows
        addOnDetails {
          code
          category
          type
          name
          associationType
          classifications
          price {
            amount
            totalAmount
            discount
            currencyCode
          }
        }
        category
        isPerSailorPurchase
        discoverDescription
        maximumQuantity
        highlightPillIcon {
          src
        }
        highlightPillLabel
        bookingSortPriority
        sellType
        hideOnAddonPage
      }
    }
