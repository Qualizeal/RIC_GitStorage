            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="C_AuthorizationToken" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def response = prev.getResponseDataAsString()

// Regex to capture JWT starting with your fixed header
def matcher = (response =~ /(eyJhbGciOiJSUzI1NiIsInR5cCIgOiAiSldUIiwia2lkIiA6ICJ0SDAxRDJFczFlSFV1SnVHdTRrRlg0ZjRoS2lpT25MV2JHVHFhQUtOMkJFIn0\.[^&quot;\]]+)/)

if (matcher.find()) {
    def token = matcher.group(1)
    vars.put(&quot;C_AuthorizationToken&quot;, token)
    log.info(&quot;Captured Token: &quot; + token)
} else {
    log.error(&quot;Authorization token not found!&quot;)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
