            <stringProp name="GraphQLHTTPSampler.operationName">BookConfirmation</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">
  query BookConfirmation($clientTransactionId: String, $reservationNumber: Int!, $isVip: Boolean!, $encResId: String!) {
    bookConfirmationV2(
      clientTransactionId: $clientTransactionId
      reservationNumber: $reservationNumber
      isVip: $isVip
      encResId: $encResId
    ) {
      paymentMethod {
        cardMaskedNo
        cardType
        paymentModeCode
      }
      todoList {
        checkInApp {
          startDate
        }
        onboardActivities {
          startDate
          endDate
        }
        sailorInfo {
          endDate
        }
        shoreExcursions {
          startDate
          endDate
        }
      }
    }
  }
</stringProp>
